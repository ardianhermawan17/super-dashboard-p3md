# dependencies (any depth; the template has its own rooted rules)
node_modules/

# secrets: never commit (contract C-07). Keep *.example files.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*service-key*.json
*-key.json
*.pem

# generated by our own tooling
# graphify-out/
# graphify leaves transient backup files during its replace step
graphify-out/cache/.gfy-replace-bak-*.tmp
.ecc/
# agent-evaluate: per-step telemetry and raw billing exports stay local (reports/ is committed)
agent-evaluate/out/
agent-evaluate/data/
# obsidian-out: only its README is committed (see obsidian-out/README.md)
# obsidian-out/*
# !obsidian-out/README.md
obsidian-out/.obsidian/plugins/

# OS / editor
.DS_Store
Thumbs.db
.idea/
