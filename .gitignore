# dependencies (any depth; the template has its own rooted rules)
node_modules/

# secrets: never commit (contract C-07). Keep *.example files.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*service-key*.json
*-key.json
*.pem

# generated by our own tooling
# graphify-out/
# graphify leaves transient backup files during its replace step
graphify-out/cache/.gfy-replace-bak-*.tmp
.ecc/
# agent scratch: working files, logs, and a headless-Chrome profile that may hold cookies
.scratch/
# agent-evaluate: per-step telemetry and raw billing exports stay local (reports/ is committed)
agent-evaluate/out/
agent-evaluate/data/
# obsidian-out: only its README is committed (see obsidian-out/README.md)
# obsidian-out/*
# !obsidian-out/README.md
# vendored plugin bundles and per-user app state: never generated by our
# tooling (scripts/obsidian-sync.ts never touches .obsidian/*), churns on
# every vault open, and plugin data.json files can carry local secrets
# (e.g. remotely-save). Keep only community-plugins.json/core-plugins.json,
# which pin which plugins a fresh vault should enable.
obsidian-out/.obsidian/plugins/
obsidian-out/.obsidian/app.json
obsidian-out/.obsidian/appearance.json
obsidian-out/.obsidian/graph.json
obsidian-out/.obsidian/types.json
obsidian-out/.obsidian/workspace.json

# OS / editor
.DS_Store
Thumbs.db
.idea/
